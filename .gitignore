# LaTeX: latexmk output folders and logs
build
*.log

# Generated from the .tex files by `pnpm content` (also run by `pnpm dev`,
# `pnpm build` and the GitHub Pages workflow)
/src/generated/
/public/downloads/
/public/slides/
# Only in the private build (PRIVATE_SITE=1), never published
/public/audio/

# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.pnpm-debug.log*

# env files (.env.dev: where pnpm deploy:private puts the private build)
.env*
!.env.dev.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated audio (large; regenerate from content/**/audio/*-spoken.txt)
*.mp3
