# Where pnpm deploy:private puts the private build. Copy to .env.dev (not in
# git) and fill in.

# The server, as ssh and rsync know it (an ssh alias, or user@host).
PRIVATE_DEPLOY_HOST=

# The folder on the server that holds the site, relative to the home folder.
PRIVATE_DEPLOY_DIR=

# The address the server serves that folder at, without a trailing slash.
PRIVATE_BASE_PATH=
